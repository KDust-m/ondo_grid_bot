# 서버 설정 파일 예시
# 실제 파일 위치: /etc/ondo-grid/<페어>.env   (예: /etc/ondo-grid/BTC-USD.P.env)
# 권한: sudo chmod 600 /etc/ondo-grid/*.env   (root 만 읽기 가능, 봇은 systemd 가 전달)
# 페어는 파일 이름(= 서비스 인스턴스 이름)으로 정해집니다.

ONDO_API_KEY_ID=ondoKeyId_여기에입력
ONDO_API_SECRET=ondoApiSecret_여기에입력

# 아래 3개는 "신규 시작" 때만 사용됩니다. 재시작 시에는 기존 그리드 설정을 그대로 이어갑니다.
GRID_STEP_PCT=0.2
LEVERAGE=10
ORDER_PCT=5
